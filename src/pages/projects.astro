---
import RootLayout from '@/layouts/RootLayout.astro'
import SimpleLayout from '@/components/SimpleLayout.astro'
import Card from '@/components/Card.astro'
import CardDescription from '@/components/CardDescription.astro'
import StructuredData from '@/components/StructuredData.astro'
import AuditWidget from '@/components/AuditWidget.astro'
import logoAuditZap from '@/images/logos/auditzap.svg'

const SITE_URL = import.meta.env.PUBLIC_SITE_URL || 'https://jethromay.com'

const projects = [
  {
    name: 'AuditZap',
    description:
      'AI-powered website audits with CMS-specific fix instructions. 40 checks across SEO, performance, and site health, ranked by revenue impact.',
    link: { href: 'https://auditzap.io', label: 'auditzap.io' },
    logo: logoAuditZap,
    tech: ['Next.js', 'TypeScript', 'Drizzle ORM', 'BullMQ', 'Claude AI'],
  },
] as const

const title = 'Projects - Jethro May'
const intro = "Side projects, tools, and experiments I've shipped."
const description =
  'Side projects, tools, and experiments by Jethro May, including AuditZap, an AI-powered website audit tool that finds SEO, performance, and site health issues.'
---

<RootLayout
  title={title}
  description={description}
  canonical={`${SITE_URL}/projects`}
>
  <StructuredData
    slot="head"
    data={{
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: title,
      description,
      url: `${SITE_URL}/projects`,
    }}
  />
  <SimpleLayout title="Things I've built" intro={intro}>
    <ul
      role="list"
      class="grid grid-cols-1 gap-x-12 gap-y-16 sm:grid-cols-2 lg:grid-cols-3"
    >
      {
        projects.map((project) => (
          <Card as="li">
            <div class="relative z-10 flex h-12 w-12 items-center justify-center rounded-full bg-white shadow-md shadow-zinc-800/5 ring-1 ring-zinc-900/5 dark:border dark:border-zinc-700/50 dark:bg-zinc-800 dark:ring-0">
              <img
                src={project.logo.src}
                alt=""
                width="32"
                height="32"
                class="h-8 w-8"
              />
            </div>
            <h2 class="mt-6 text-base font-semibold text-zinc-800 dark:text-zinc-100">
              <div class="absolute -inset-x-4 -inset-y-6 z-0 scale-95 bg-zinc-50 opacity-0 transition group-hover:scale-100 group-hover:opacity-100 sm:-inset-x-6 sm:rounded-2xl dark:bg-zinc-800/50" />
              <a
                href={project.link.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="absolute -inset-x-4 -inset-y-6 z-20 sm:-inset-x-6 sm:rounded-2xl" />
                <span class="relative z-10">{project.name}</span>
              </a>
            </h2>
            <CardDescription>{project.description}</CardDescription>
            <div class="relative z-10 mt-4 flex flex-wrap gap-1.5">
              {project.tech.map((t) => (
                <span class="inline-flex items-center rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs font-medium text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400">
                  {t}
                </span>
              ))}
            </div>
            <p class="relative z-10 mt-4 flex text-sm font-medium text-zinc-400 transition group-hover:text-teal-500 dark:text-zinc-200">
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
                class="h-6 w-6 flex-none"
              >
                <path
                  d="M15.712 11.823a.75.75 0 1 0 1.06 1.06l-1.06-1.06Zm-4.95 1.768a.75.75 0 0 0 1.06-1.06l-1.06 1.06Zm-2.475-1.414a.75.75 0 1 0-1.06-1.06l1.06 1.06Zm4.95-1.768a.75.75 0 1 0-1.06 1.06l1.06-1.06Zm3.359.53-.884.884 1.06 1.06.885-.883-1.061-1.06Zm-4.95-2.12 1.414-1.415L12 6.344l-1.415 1.413 1.061 1.061Zm0 3.535a2.5 2.5 0 0 1 0-3.536l-1.06-1.06a4 4 0 0 0 0 5.656l1.06-1.06Zm4.95-4.95a2.5 2.5 0 0 1 0 3.535L17.656 12a4 4 0 0 0 0-5.657l-1.06 1.06Zm1.06-1.06a4 4 0 0 0-5.656 0l1.06 1.06a2.5 2.5 0 0 1 3.536 0l1.06-1.06Zm-7.07 7.07.176.177 1.06-1.06-.176-.177-1.06 1.06Zm-3.183-.353.884-.884-1.06-1.06-.884.883 1.06 1.06Zm4.95 2.121-1.414 1.414 1.06 1.06 1.415-1.413-1.06-1.061Zm0-3.536a2.5 2.5 0 0 1 0 3.536l1.06 1.06a4 4 0 0 0 0-5.656l-1.06 1.06Zm-4.95 4.95a2.5 2.5 0 0 1 0-3.535L6.344 12a4 4 0 0 0 0 5.656l1.06-1.06Zm-1.06 1.06a4 4 0 0 0 5.657 0l-1.061-1.06a2.5 2.5 0 0 1-3.535 0l-1.061 1.06Zm7.07-7.07-.176-.177-1.06 1.06.176.178 1.06-1.061Z"
                  fill="currentColor"
                />
              </svg>
              <span class="ml-2">{project.link.label}</span>
            </p>
          </Card>
        ))
      }
    </ul>
    <AuditWidget
      class="mt-16 sm:mt-20"
      headingLevel="h2"
      description="AuditZap ships an embeddable version of its audit form. This is that widget, running live - the same embed anyone can drop on their own site. Enter a URL and the report lands in your inbox."
    />
  </SimpleLayout>
</RootLayout>
