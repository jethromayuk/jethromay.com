---
interface Props {
  class?: string
  variant?: 'outer' | 'inner' | 'both'
  style?: string
}

const { class: className = '', variant = 'both', style } = Astro.props
---

{
  variant === 'outer' ? (
    <div class={`sm:px-8 ${className}`} style={style}>
      <div class="mx-auto max-w-7xl lg:px-8">
        <slot />
      </div>
    </div>
  ) : variant === 'inner' ? (
    <div class={`relative px-4 sm:px-8 lg:px-12 ${className}`} style={style}>
      <div class="mx-auto max-w-2xl lg:max-w-5xl">
        <slot />
      </div>
    </div>
  ) : (
    <div class={`sm:px-8 ${className}`} style={style}>
      <div class="mx-auto max-w-7xl lg:px-8">
        <div class="relative px-4 sm:px-8 lg:px-12">
          <div class="mx-auto max-w-2xl lg:max-w-5xl">
            <slot />
          </div>
        </div>
      </div>
    </div>
  )
}
